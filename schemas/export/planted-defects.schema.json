{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credit-audit/planted-defects@1",
  "title": "Planted-defect table",
  "description": "The harness validated against agents whose true decision rule we wrote ourselves. This is the strongest artifact the project has: it converts 'trust my harness' into 'here is the harness catching known-answer defects'. Present on scripted runs; model runs reference one via validated_by_run_id.",
  "type": "object",
  "required": ["schema", "source_run_id", "agents", "summary"],
  "properties": {
    "schema": { "const": "credit-audit/planted-defects@1" },
    "source_run_id": { "type": "string" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "true_driver", "defect", "must_fire", "must_not_fire", "verdict"],
        "properties": {
          "agent": { "type": "string" },
          "true_driver": {
            "type": "string",
            "description": "The agent's actual decision rule, which we control exactly."
          },
          "stated_driver": { "type": "string" },
          "defect": { "type": "string" },
          "must_fire": {
            "type": "array",
            "items": { "$ref": "#/$defs/expectation" }
          },
          "must_not_fire": {
            "type": "array",
            "description": "As important as must_fire. A harness that fails everything catches everything; specificity is what a sharp reviewer checks. Given equal visual weight on the site.",
            "items": { "$ref": "#/$defs/expectation" }
          },
          "verdict": { "enum": ["CAUGHT", "MISSED", "FALSE_ALARM", "PARTIAL"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["n_agents", "caught", "missed", "false_alarms"],
      "properties": {
        "n_agents": { "type": "integer" },
        "caught": { "type": "integer" },
        "missed": { "type": "integer" },
        "false_alarms": { "type": "integer" },
        "positive_control": {
          "type": "object",
          "description": "The clean agent. Its pass rate is what proves the repair machinery works rather than the checks simply failing everything.",
          "properties": {
            "agent": { "type": "string" },
            "pass_rate": { "type": "number" },
            "ci95": { "type": "array", "items": { "type": "number" } }
          }
        }
      }
    }
  },
  "$defs": {
    "expectation": {
      "type": "object",
      "required": ["check", "expected_rate", "observed_rate", "within_tolerance"],
      "properties": {
        "check": { "type": "string" },
        "expected_rate": {
          "type": "number",
          "description": "Analytically derived from the scripted agent's known rule, not observed."
        },
        "expected_code": { "type": ["string", "null"] },
        "tolerance": { "type": "number" },
        "observed_rate": { "type": "number" },
        "ci95": { "type": ["array", "null"], "items": { "type": "number" } },
        "n": { "type": "integer" },
        "within_tolerance": { "type": "boolean" },
        "exemplar_pair_id": { "type": ["string", "null"] }
      }
    }
  }
}
