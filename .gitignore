# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local agent transcripts and worktrees are implementation notes, never audit evidence.
.claude/

# Private paid-provider operating instructions. Never commit this local runbook.
docs/private-real-provider-runbook.md

# Raw run artifacts NEVER enter git.
# Scripted runs regenerate in under a minute at zero cost; real-model runs ship as
# GitHub Release assets with their sha256 recorded in the exported integrity/chain.json.
# The exported bundle under web/public/runs/ IS committed — that is deliberate.
# Root-anchored on purpose. An unanchored `runs/` matches *any* directory of that name,
# including web/public/runs/, and git does not descend into an ignored directory -- so the
# negations below could never rescue the published bundle. That would silently empty the site
# and defeat the CI staleness gate that diffs it.
/runs/

# Full-size run cassettes are raw evidence, not published artifacts, and follow the same rule
# as raw JSONL: their sha256 lands in the exported integrity chain and they ship as Release
# assets rather than in git. Anyone with a key regenerates one for a few dollars. The small
# committed cassettes under tests/fixtures/ are different -- they are test fixtures, and they
# are what lets CI replay real provider bytes at zero cost.
web/public/cassettes/
*.jsonl
!tests/**/*.jsonl
!web/public/runs/**/*.jsonl
!src/credit_audit/profiles/fixtures/*.jsonl

# Secrets
.env
.env.*
!.env.example

